# Normalize line endings across machines so commits stop flip-flopping
# between LF and CRLF (the "LF will be replaced by CRLF" warnings).
* text=auto

# PowerShell: keep CRLF in the working tree (ISE/legacy tools prefer it)
*.ps1 text eol=crlf

# Markdown, YAML, JSON: LF everywhere
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
